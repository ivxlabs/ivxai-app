{
  "name": "ivxai-app",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "description": "A lightweight, browser-based chat client designed for users who want total control over their data and their AI interactions.",
  "license": "GPL-3.0-or-later",
  "author": "0xcrypto (https://eval.blog)",
  "repository": { "type": "git", "url": "git+https://github.com/ivxlabs/ivxai-app.git" },
  "scripts": {
    "postinstall": "npm --prefix web install",
    "dev": "tauri dev",
    "build": "tauri build",
    "android:init": "tauri android init && node scripts/android-overlay.mjs",
    "android:overlay": "node scripts/android-overlay.mjs",
    "android": "node scripts/android-overlay.mjs && tauri android dev",
    "ios": "tauri ios dev",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "web:check": "npm --prefix web run check",
    "ext:build": "node scripts/extension-build.mjs",
    "ext:test": "node scripts/extension-test.mjs",
    "ext:safari": "node scripts/safari-project.mjs",
    "ext:publish": "node scripts/webstore-publish.mjs",
    "ext:publish:firefox": "node scripts/amo-publish.mjs",
    "bridge": "cargo run --release -p ivxai-bridge --",
    "bridge:build": "cargo build --release -p ivxai-bridge",
    "test": "cargo test --workspace",
    "bump": "node scripts/version.mjs",
    "brand": "node scripts/branding.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
